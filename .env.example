# توکن بازوی بله — از @botfather در بله بگیرید (الزامی)
BALE_BOT_TOKEN=123456789:ABCDEF...

# اختیاری: شناسه عددی مالک در بله.
# اگر خالی بگذارید، اولین کسی که /start بزند به‌عنوان مالک ثبت می‌شود.
# ADMIN_BALE_USER_ID=

# اختیاری
# BOT_USERNAME=nasoz_bot
# DATABASE_PATH=data/bot.db
# POLL_TIMEOUT=25

# Days-of-cover threshold for critical materials (default 3)
CRITICAL_DAYS=3

# Surplus report thresholds
# SURPLUS_COVER_DAYS=10
# SURPLUS_FORECAST_DAYS=30

# دستیار هوشمند (Ollama محلی روی همین ماشین — بدون LLM ابری)
# پیش‌فرض خاموش؛ برای فعال‌سازی: ASSISTANT_ENABLED=1
ASSISTANT_ENABLED=0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=60

# داشبورد وب (فرآیند جدا از ربات بله — توکن بله لازم نیست)
# WEB_SECRET_KEY=یک-رشته-تصادفی-بلند
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# فقط برای اولین seed اگر هیچ credential وب وجود نداشته باشد:
# WEB_ADMIN_USERNAME=admin
# WEB_ADMIN_PASSWORD=...
